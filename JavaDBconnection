		public static void insertingrecords() throws Exception{
			String url="jdbc:mysql://localhost:3306/jdbcdemo1";
			String username="root";
			String password="-------";
			String query ="insert into products values('ponds',2,90.0)"; 
			Connection con = DriverManager.getConnection(url,username,password);
			Statement st = con.createStatement();
			int rows =st.executeUpdate(query); 
		
			System.out.println("how many records affected ="+rows);
			con.close();
			}
		public static void insertvarusingpst() throws Exception{
			String url="jdbc:mysql://localhost:3306/jdbcdemo1";
			String username="root";
			String password="----------";
			String name="ponts";
			int id = 2;
			float rate=(float) 80.35;
			String query ="insert into products values(?,?,?);";
			//String query2="delete from products;";
			Connection con = DriverManager.getConnection(url,username,password);
			PreparedStatement pst = con.prepareStatement(query);
     		pst.setString(1, name);
			pst.setInt(2, id);
			pst.setFloat(3, rate);
			int rows =pst.executeUpdate(); 
		
			System.out.println("how many rows affected ="+rows);
			con.close();
			}
