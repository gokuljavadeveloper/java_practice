            String query1="update products set productrate=100.97 where prodid=2";
            String query2="update products set productrate=100.97 where prodid=1"; //we did one mistake in update keyword,so input is wrong but in java setautocommit is true now we change its 
			Connection con = DriverManager.getConnection(url,username,password); 
            con.setAutoCommit(false);
   		    Statement st= con.createStatement();
            int row1= st.executeUpdate(query1);
            st=con.createStatement();
            int row2=st.executeUpdate(query2);
            if(row1>0&&row2>0) {con.commit();}
			
		
			System.out.println("how many rows affected ="+row1);
			System.out.println("how many rows affected ="+row2);
			con.close();
			}
		public static void batchprocessing() throws Exception{
			String url="jdbc:mysql://localhost:3306/jdbcdemo1";
			String username="root";
			String password="-----------";
            String query1="update products set productrate=1400.97 where prodid=1";
            String query2="update products set productrate=1400.97 where prodid=2";
            String query3="update products set productrate=1400.97 where prodid=3";
            String query4="update products set productrate=1400.97 where prodid=4";
            //we made one mistake for learn setautocommit but real world ex: if problems are come when user using gpay or anythinh else,so prevent the whole debit,credit activities;
            
			Connection con = DriverManager.getConnection(url,username,password); 
            con.setAutoCommit(false);
			Statement st=con.createStatement();
            st.addBatch(query1);
            st.addBatch(query2);
            st.addBatch(query3);
            st.addBatch(query4);
            int[]row=st.executeBatch();
             for(var rows:row) {
            	 if(rows>0) 
            	 {
            	 System.out.println("number of rows affected= "+rows);
                  continue;
            	 }
            	 else
            	 {
            		 con.rollback();
            	 }
			con.commit();
			con.close();
			}
 		}
