package gokusdb;
import java.sql.*;
import java.util.*;
public class Passanger_Details{
Connection con=JDBCCONNECTION_BusReservation.getConnections();
public Passanger_Details() throws Exception{
    System.out.println("Please Enter your Name");
    Scanner sc = new Scanner(System.in);
    String name = sc.next();
    System.out.println("Please Enter your mobile number for TicketBooking");
    long number=sc.nextLong();
    String query="insert into passangers values(?,?)";
    PreparedStatement pst = con.prepareStatement(query);
    pst.setString(1,name);
	  pst.setLong(2, number);
	  pst.executeUpdate();
	System.out.println("Thanks for giving this  data.");
	System.out.println("********************************");
	}


}
